# Copia este archivo como ".env" y completa los valores. NO subas el .env a Git.

# Clave para firmar los tokens JWT (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Minutos que dura el token de acceso (corto: se renueva solo con la cookie de sesión). Recomendado: 15
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Base de datos. Por defecto SQLite local (no necesitas cambiar nada para desarrollo):
DATABASE_URL=sqlite:///./propiedad_horizontal.db
# Para Supabase (PostgreSQL) usa la cadena de conexión de tu proyecto, por ejemplo:
# Usa el "Session pooler" (puerto 5432): la conexión directa solo funciona por IPv6. El usuario es postgres.<id-del-proyecto>.
# Si tu clave tiene símbolos, codifícalos (@ -> %40, # -> %23, / -> %2F).
# DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Carpeta local donde se guardan las fotos de los reportes
UPLOAD_DIR=uploads

# Datos del primer administrador (lo usa: python -m app.seed)
ADMIN_EMAIL=admin@conjunto.com
ADMIN_NOMBRE=Administrador del Conjunto
ADMIN_PASSWORD=

# Fase 2 (comercio): cómo deben pagar los vecinos que quieren anunciarse (texto libre).
# COMERCIO_INSTRUCCIONES_PAGO=Transfiere a Bancolombia ahorros 000-000000-00 (Nequi 300 000 0000) y escribe el número del comprobante.

# Bloque 3 (correo): si dejas SMTP_HOST vacío, solo se muestran avisos dentro de la app (la campana).
# Ejemplo con Gmail: crea una "contraseña de aplicación" en tu cuenta de Google y úsala aquí (no tu clave normal).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=Ciudadela Digital <tu_correo@gmail.com>

# Versión 2.7: horas de sesión de la cuenta de portería (un turno). Las demás cuentas usan ACCESS_TOKEN_EXPIRE_MINUTES.
# GUARDIA_TOKEN_HORAS=12

# Versión 2.8 — archivos (fotos y PDF). «local» = carpeta UPLOAD_DIR; «supabase» = Supabase Storage (recomendado en producción:
# los hostings gratuitos borran el disco al reiniciar). Crea un bucket PRIVADO llamado ciudadela-archivos en Supabase → Storage.
# ALMACEN=supabase
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx     # Supabase → Settings → API Keys. SOLO en el servidor; NUNCA en el frontend ni en GitHub.
# SUPABASE_BUCKET=ciudadela-archivos

# Versión 2.8 — pagos. 1 = botón «Pagar ahora» de demostración (para la sustentación). 0 = producción: el residente paga por
# transferencia y el administrador registra el pago recibido (Cartera → Registrar pago).
PAGOS_SIMULADOS=1
# PAGOS_INSTRUCCIONES=Transfiere a Bancolombia ahorros 000-000000-00 (Nequi 300 000 0000) y avisa en la oficina.

# Versión 2.9 (asistente de IA): ayuda a redactar borradores de PQRS, daños y anuncios. NUNCA publica ni envía nada solo.
# Sin IA_API_KEY el asistente queda apagado y la app funciona igual con sus formularios.
# Gratis con Google AI Studio (https://aistudio.google.com/apikey). La clave vive SOLO aquí (servidor), nunca en el frontend.
# Ojo: en el plan gratis Google puede usar lo que se envía para mejorar sus productos → en demostraciones usa datos ficticios.
# PROVEEDOR_IA=gemini            # gemini | groq | compatible (API estilo OpenAI; exige IA_URL_BASE e IA_MODELO)
# IA_API_KEY=
# IA_MODELO=                     # vacío = gemini-3.5-flash. Los nombres cambian: para ver los de tu cuenta corre  python -m app.diagnostico_ia
# IA_URL_BASE=                   # solo para PROVEEDOR_IA=compatible, p. ej. https://openrouter.ai/api/v1
# IA_PENSAMIENTO=low           # solo Gemini 3.x: minimal | low | medium | high. «low» = respuestas rápidas (recomendado)
# IA_TIMEOUT_SEGUNDOS=45         # cuánto espera a la IA antes de rendirse
# IA_LIMITE_DIARIO_USUARIO=10    # consultas por persona al día (hora de Colombia)
# IA_LIMITE_DIARIO_GLOBAL=100    # consultas de todo el conjunto al día (protege la cuota gratuita)
# IA_LIMITE_CHAT_USUARIO=30     # mensajes al chat por persona al día (aparte de los borradores)
# IA_LIMITE_CHAT_GLOBAL=300     # mensajes al chat de todo el conjunto al día

# ---- Versión 3.1 ----
# Avisos push al celular. Genera el par con:  python -m app.generar_vapid   (la PRIVADA nunca se sube a GitHub)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu_correo@ejemplo.com
# Sesión segura: el token de acceso dura poco y se renueva solo; la sesión dura:
# GUARDIA_TOKEN_HORAS=12      # portería: un turno completo
# SESION_DIAS_ADMIN=7
# SESION_DIAS=14              # residentes
# SESION_MAXIMA_DIAS=60       # tope absoluto aunque la usen todos los días
# BCRYPT_ROUNDS=12            # no lo bajes en producción

# Versión 3.5 — página pública del pase de visitante (/pase/<token>). Todo es opcional.
# Con LATITUD y LONGITUD el visitante ve «Cómo llegar» (Google Maps y Waze) hacia el punto exacto de la portería (clic derecho en Google Maps → copiar coordenadas).
# Sin coordenadas se usa la dirección escrita; sin ninguna de las dos, los botones de mapa no aparecen.
# CONJUNTO_NOMBRE=Conjunto Residencial Los Pinos
# CONJUNTO_DIRECCION=Calle 10 # 5-20, Facatativá, Cundinamarca
# CONJUNTO_LATITUD=4.8133
# CONJUNTO_LONGITUD=-74.3541

# Versión 3.6 — paz y salvo con QR (opcional).
# PAZ_Y_SALVO_DIAS=30                     # cuántos días sirve un certificado (1 a 365)
# URL_PUBLICA=https://tu-app.onrender.com # solo si el QR del PDF saliera con una dirección interna; normalmente se deduce sola

# ---- Versión 4.0 — presentación comercial (todo opcional) ----
# WHITE-LABEL: para entregar la app a otro conjunto o empresa basta cambiar estas variables (y, si quieres, poner sus logos en la carpeta marca/).
# MARCA_NOMBRE=Torres del Alba                 # nombre del producto: pestaña, menú, PDF, correos y chat (por defecto: Ciudadela Digital)
# MARCA_NOMBRE_CORTO=Alba                       # el que sale bajo el icono en el celular (máx. 14 letras)
# MARCA_ESLOGAN=Vive tranquilo, vive en Alba.   # titular del login (lo que va después de la última coma se resalta)
# MARCA_DESCRIPCION=Tu conjunto en el celular.  # descripción corta (buscadores y al instalar)
# MARCA_COLOR=#8A1C2B                           # color principal #RRGGBB: login, administrador y landing. Los colores por rol no cambian
# MARCA_ASISTENTE=Albita                        # nombre del asistente de chat (por defecto: Ciudabot)
# MARCA_DIR=                                    # carpeta con los logos del cliente (por defecto: marca/)
# DOCS_ACTIVAS=1                                # 1 = /docs (Swagger) visible, útil para la demo. 0 = oculto: ponlo en 0 en la app de un cliente ya contratado
# Landing comercial en «/» (la app queda en /app/):
# LANDING_ACTIVA=1                              # 0 = la raíz lleva directo a la app (lo que quieres en la app de un cliente ya contratado)
# DEMO_WHATSAPP=3101234567                      # WhatsApp de ventas (10 dígitos que empiecen por 3, o con indicativo). Vacío = sin botón de WhatsApp
# DEMO_CONTACTO=Cristhian                       # quien atiende ese WhatsApp: el mensaje de la landing empieza «Hola Cristhian, revisé la demo…» (vacío = «Hola, …»)
# DEMO_CORREO=ventas@tuempresa.com              # correo de ventas que se muestra junto al formulario (opcional)
