# Copia este archivo como ".env" y completa los valores. NO subas el .env a Git.

# Clave para firmar los tokens JWT (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Minutos que dura el token de acceso
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de datos. Por defecto SQLite local (no necesitas cambiar nada para desarrollo):
DATABASE_URL=sqlite:///./propiedad_horizontal.db
# Para Supabase (PostgreSQL) usa la cadena de conexión de tu proyecto, por ejemplo:
# Usa el "Session pooler" (puerto 5432): la conexión directa solo funciona por IPv6. El usuario es postgres.<id-del-proyecto>.
# Si tu clave tiene símbolos, codifícalos (@ -> %40, # -> %23, / -> %2F).
# DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Carpeta local donde se guardan las fotos de los reportes
UPLOAD_DIR=uploads

# Datos del primer administrador (lo usa: python -m app.seed)
ADMIN_EMAIL=admin@conjunto.com
ADMIN_NOMBRE=Administrador del Conjunto
ADMIN_PASSWORD=

# Fase 2 (comercio): cómo deben pagar los vecinos que quieren anunciarse (texto libre).
# COMERCIO_INSTRUCCIONES_PAGO=Transfiere a Bancolombia ahorros 000-000000-00 (Nequi 300 000 0000) y escribe el número del comprobante.

# Bloque 3 (correo): si dejas SMTP_HOST vacío, solo se muestran avisos dentro de la app (la campana).
# Ejemplo con Gmail: crea una "contraseña de aplicación" en tu cuenta de Google y úsala aquí (no tu clave normal).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=Ciudadela Digital <tu_correo@gmail.com>

# Versión 2.7: horas de sesión de la cuenta de portería (un turno). Las demás cuentas usan ACCESS_TOKEN_EXPIRE_MINUTES.
# GUARDIA_TOKEN_HORAS=12

# Versión 2.8 — archivos (fotos y PDF). «local» = carpeta UPLOAD_DIR; «supabase» = Supabase Storage (recomendado en producción:
# los hostings gratuitos borran el disco al reiniciar). Crea un bucket PRIVADO llamado ciudadela-archivos en Supabase → Storage.
# ALMACEN=supabase
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx     # Supabase → Settings → API Keys. SOLO en el servidor; NUNCA en el frontend ni en GitHub.
# SUPABASE_BUCKET=ciudadela-archivos

# Versión 2.8 — pagos. 1 = botón «Pagar ahora» de demostración (para la sustentación). 0 = producción: el residente paga por
# transferencia y el administrador registra el pago recibido (Cartera → Registrar pago).
PAGOS_SIMULADOS=1
# PAGOS_INSTRUCCIONES=Transfiere a Bancolombia ahorros 000-000000-00 (Nequi 300 000 0000) y avisa en la oficina.
